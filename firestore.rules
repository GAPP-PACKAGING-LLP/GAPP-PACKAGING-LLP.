rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and role verification
    match /users/{uid} {
      allow read, write: if true;
    }

    // Directors / Management collection
    match /directors/{directorId} {
      allow read, write: if true;
    }

    // Customer Inquiries collection
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Public readable collections for site display, managed by CMS
    match /products/{productId} {
      allow read, write: if true;
    }

    match /machinery/{machineryId} {
      allow read, write: if true;
    }

    match /testingEquipment/{equipmentId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;
    }

    match /gallery/{imageId} {
      allow read, write: if true;
    }

    match /brochures/{brochureId} {
      allow read, write: if true;
    }

    match /pages/{pageId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
